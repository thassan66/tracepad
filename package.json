{
  "name": "tracepad",
  "version": "0.5.1",
  "description": "Debugging flight recorder CLI for handoffs, PR briefs, incident replay, and reproducible investigation trails.",
  "author": "Taimoor Hassan",
  "homepage": "https://github.com/thassan66/tracepad#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thassan66/tracepad.git"
  },
  "bugs": {
    "url": "https://github.com/thassan66/tracepad/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "tracepad": "./bin/tracepad"
  },
  "files": [
    "bin/",
    "docs/*.md",
    "schema/",
    "scripts/smoke.js",
    "src/plugins/",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node ./scripts/smoke.js",
    "verify": "node ./scripts/smoke.js && node ./scripts/validate-extension.js",
    "smoke": "node ./scripts/smoke.js",
    "extension:validate": "node ./scripts/validate-extension.js",
    "extension:package": "node ./scripts/package-extension.js",
    "pack:dry": "npm pack --dry-run",
    "demo": "node ./bin/tracepad.js --help",
    "capture:help": "node ./bin/tracepad.js capture --help",
    "record:help": "node ./bin/tracepad.js record --help",
    "tui:help": "node ./bin/tracepad.js tui --help",
    "replay:help": "node ./bin/tracepad.js replay --help",
    "alias:setup": "node ./bin/tracepad.js alias setup",
    "export:slack": "node ./bin/tracepad.js export --exporter slack",
    "demo:hero": "vhs docs/demo/hero.tape",
    "demo:hero:docker": "docker build -f docs/demo/Dockerfile.vhs -t tracepad-vhs . && docker run --rm -v \"%cd%:/work\" -w /work tracepad-vhs docs/demo/hero.tape"
  },
  "keywords": [
    "debugging",
    "incident",
    "handoff",
    "terminal",
    "tui",
    "engineering",
    "cli",
    "flight-recorder",
    "devtools",
    "postmortem",
    "git-hooks",
    "incident-response",
    "shell-integration",
    "plugins"
  ],
  "license": "MIT"
}
